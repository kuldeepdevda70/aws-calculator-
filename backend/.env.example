# AWS Configuration (Default Region is ap-south-1 Mumbai)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY= 
# Optional: only if using temporary credentials (AWS SSO / AWS Academy / STS)
AWS_SESSION_TOKEN=

# Server & App Settings
APP_NAME=Cloud to AWS Migration Cost Estimator
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Upload & File Retention Policy (bills automatically deleted after 24 hours)
UPLOAD_DIR=uploads
FILE_RETENTION_HOURS=24
MAX_FILE_SIZE_MB=50

# Configuration Rules Path
RULES_CONFIG_PATH=config/rules.json
